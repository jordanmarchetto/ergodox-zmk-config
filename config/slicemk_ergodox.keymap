#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define L_DEF 0
#define L_NUM 1
#define L_MAC 2

#define C_NONE RGB_COLOR_HSB(0,0,0)
#define C_PURPLE RGB_COLOR_HSB(273,100,100)
#define C_TEAL RGB_COLOR_HSB(169,100,100)
#define C_PINK RGB_COLOR_HSB(335,60,100)

//https://zmk.dev/docs/codes
//https://config.slicemk.com/ergodox/keymap/?example=qwerty.json
//https://www.slicemk.com/pages/nvsclear - how to clear pairings
//https://github.com/slicemk/ergodox-diy - svgs
//https://discord.com/channels/804036937571631124/852408228038180894 - discord

//ref: https://github.com/slicemk/ergodox-zmk-config/blob/master/config/slicemk_ergodox.keymap //stock
//ref: https://github.com/feerrenrut/ergodox-zmk-config/blob/master/config/slicemk_ergodox.keymap //qol stuff
//ref: https://github.com/djak250/ergodox-zmk-config/blob/master/config/slicemk_ergodox.keymap //rgb stuff

//TODO:
// find cool new macros

#define HYP LS(LC(LA(LGUI)))
#define MEH LC(LA(LGUI))
#define HYPER(key) LS(LC(LA(LG(key))))

/ {
	keymap {
		compatible = "zmk,keymap";

/* Keymap 0: Basic layer
 *
 * ,-----------------------------------------------------.           ,--------------------------------------------------.
 * |   `       |   1  |   2  |   3  |   4  |   5  | ESC  |           | F18  |   6  |   7  |   8  |   9  |   0  |   -    |
 * |-----------+------+------+------+------+-------------|           |------+------+------+------+------+------+--------|
 * | Tab       |   Q  |   W  |   E  |   R  |   T  |  L1  |           |  =   |   Y  |   U  |   I  |   O  |   P  |   \    |
 * |-----------+------+------+------+------+------|      |           |      |------+------+------+------+------+--------|
 * | CAPS      |   A  |   S  |   D  |   F  |   G  |------|           |------|   H  |   J  |   K  |   L  |   ;  |    '   |
 * |-----------+------+------+------+------+------|  L2  |           | L0   |------+------+------+------+------+--------|
 * | KC_LSHIFT |   Z  |   X  |   C  |   V  |   B  |      |           |      |   N  |   M  |   ,  |   .  |   /  | RSHIFT |
 * `-----------+------+------+------+------+-------------'           `-------------+------+------+------+------+--------'
 *   |LCTL|  LAlt  |       | LALT | LGUI |                                  |  Up  | Down |   [  |   ]  | LCAG_T(Esc) |
 *   `-----------------------------------'                                  `-----------------------------------------'
 *         LCAG = Hold Left Control, Alt and GUI and press kc
 *
 *                                         ,--------------.       ,----------------.
 *                                         | F13   | F14  |       | l2/F15|  F16   |
 *                                 ,-------|-------|------|       |---------+--------+-------.
 *                                 |       |       | F17  |       | VOL+    |        |       |
 *                                 | Space | Back  |------|       |---------|  ENT   | SPACE |
 *                                 |       | space | Play |       | l1/VOL- |        |       |
 *                                 |       |       | Pause|       |         |        |       |
 *                                 `----------------------'       `--------------------------'
 */

layer_0 { //L_DEF
	bindings = <
	&bootloader
	&kp GRAV   &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4 &kp NUMBER_5 &kp ESC       &kp F18      &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp NUMBER_0  &kp MINUS
	&kp TAB    &kp Q        &kp W        &kp E        &kp R        &kp T        &rgb_to_l1    &kp EQUAL    &kp Y        &kp U        &kp I        &kp O        &kp P         &kp BSLH
	&kp CAPS   &kp A        &kp S        &kp D        &kp F        &kp G                                   &kp H        &kp J        &kp K        &kp L        &kp SEMICOLON &kp SINGLE_QUOTE
	&kp LSHFT  &kp Z        &kp X        &kp C        &kp V        &kp B        &rgb_to_l2    &rgb_to_l0   &kp N        &kp M        &kp CMMA     &kp DOT      &kp FSLH      &kp RSHFT
	&kp LCTRL  &kp LALT     &none        &kp LALT     &kp LGUI                                                          &kp UARW     &kp DARW     &kp LBKT     &kp RBKT      &mt MEH ESC
									   &kp F13      &kp F14       &lt L_MAC F15      &kp F16
							      &kp SPC      &kp BKSP     &kp F17       &kp K_VOL_UP       &kp ENTER    &kp SPC
											&kp C_PP      &lt L_NUM K_VOL_DN
	>;
};

/* Keymap 1: Number Layer
 * NOTE: By default, the OS will handle what f1,f2, etc do.  This likely means, that even though the keyboard will 
 * send f1, the OS will actually adjust the screen brightness.  To fix this, inside of Karabiner Elements, I've set
 * this keyboard (Infinity_Ergodox/QMK (Input Club), to use the correct keys and not the 'media ones'.
 *
 * ,---------------------------------------------------.           ,--------------------------------------------------.
 * |         |  F1  |  F2  |  F3  |  F4  |  F5  |      |           |      |  F6  |  F7  |  /   |  *   |   -  |        |
 * |---------+------+------+------+------+------+------|           |------+------+------+------+------+------+--------|
 * |         |      |      |      |      |      |      |           |      |      |   7  |   8  |   9  |   *  |        |
 * |---------+------+------+------+------+------|      |           |      |------+------+------+------+------+--------|
 * |         |      |      |      |      |      |------|           |------|      |   4  |   5  |   6  |   +  |        |
 * |---------+------+------+------+------+------|      |           |      |------+------+------+------+------+--------|
 * |         |      |      |      |      |      |      |           |      |      |   1  |   2  |   3  |   \  |        |
 * `---------+------+------+------+------+-------------'           `-------------+------+------+------+------+--------'
 *   |       |      |      |      |      |                                       |   0  |   0  |   .  |   =  |      |
 *   `-----------------------------------'                                       `----------------------------------'
 *                                        ,----------------.       ,-------------.
 *                                        |      |         |       |      |      |
 *                                 ,------|------|---------|       |------+------+------.
 *                                 |      |      |         |       |      |      |      |
 *                                 |      |      |---------|       |------|      |      |
 *                                 |      |      |         |       |      |      |      |
 *                                 `-----------------------'       `--------------------'
 */


layer_1 { //L_NUM
	bindings = <
		&bootloader
		&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans       &trans  &kp F6  &kp F7      &kp KP_SLASH &kp KP_ASTERISK &kp KP_MINUS    &trans
		&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &kp KP_N7   &kp KP_N8    &kp KP_N9       &kp KP_ASTERISK &trans
		&trans  &trans  &trans  &trans  &trans  &trans                       &trans  &kp KP_N4   &kp KP_N5    &kp KP_N6       &kp KP_PLUS     &trans
		&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &kp KP_N1   &kp KP_N2    &kp KP_N3       &kp KP_SLASH    &trans
		&trans  &trans  &trans  &trans  &trans                                       &kp KP_N0   &kp KP_N0    &kp KP_DOT      &kp KP_EQUAL    &trans
							&trans  &trans       &trans  &trans
						&trans  &trans  &trans       &trans  &trans  &trans
								&trans       &trans
	>;
};

layer_2 { //L_MAC
	bindings = <
		&bootloader
		&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
		&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
		&trans  &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
		&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
		&trans  &trans  &trans  &trans  &trans                                       &trans  &trans  &trans  &trans  &m_password
							&trans  &trans       &trans           &trans
						&trans  &trans  &trans       &rgb_ug RGB_BRI  &trans  &trans
								&trans       &rgb_ug RGB_BRD
	>;
};


	/* transparent starter
	layer_1 {  // L_XYZ
		bindings = <
			&bootloader
			&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
			&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
			&trans  &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
			&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
			&trans  &trans  &trans  &trans  &trans                                       &trans  &trans  &trans  &trans  &trans
								&trans  &trans       &trans  &trans
							&trans  &trans  &trans       &trans  &trans  &trans
									&trans       &trans
		>; // bindings
	}; // layer
	*/

	/* blank starter
	layer_1 {  // L_XYZ
		bindings = <
			&bootloader
			&none  &none  &none  &none  &none  &none  &none       &none  &none  &none  &none  &none  &none  &none
			&none  &none  &none  &none  &none  &none  &none       &none  &none  &none  &none  &none  &none  &none
			&none  &none  &none  &none  &none  &none                     &none  &none  &none  &none  &none  &none
			&none  &none  &none  &none  &none  &none  &none       &none  &none  &none  &none  &none  &none  &none
			&none  &none  &none  &none  &none                                   &none  &none  &none  &none  &none
							   &none  &none       &none  &none
						    &none  &none  &none       &none  &none  &none
								  &none       &none
		>; // bindings
	}; // layer
	*/

}; //end keymap

//Macros
//!@Npavjxm89!
 ZMK_MACRO(m_password, wait-ms = <1>; tap-ms = <1>; bindings = <&macro_tap &kp EXCL>, <&macro_tap &kp AT>, <&macro_tap &kp LS(N)>, <&macro_tap &kp P>, <&macro_tap &kp A>, <&macro_tap &kp V>, <&macro_tap &kp J>, <&macro_tap &kp X>, <&macro_tap &kp M>, <&macro_tap &kp NUMBER_5>, <&macro_tap &kp NUMBER_2>, <&macro_tap &kp NUMBER_2>, <&macro_tap &kp NUMBER_8>, <&macro_tap &kp NUMBER_9>, <&macro_tap &kp EXCL>, <&macro_tap &kp EXCL>;)

//rgb stuff
//https://codepen.io/HunorMarton/details/eWvewo - color picker
ZMK_MACRO(rgb_to_l0, wait-ms = <0>; tap-ms = <0>; bindings = <&macro_tap &rgb_ug C_NONE>,     <&macro_tap &to L_DEF>;)
ZMK_MACRO(rgb_to_l1, wait-ms = <0>; tap-ms = <0>; bindings = <&macro_tap &rgb_ug C_PURPLE>, <&macro_tap &to L_NUM>;)
ZMK_MACRO(rgb_to_l2, wait-ms = <0>; tap-ms = <0>; bindings = <&macro_tap &rgb_ug C_TEAL>, <&macro_tap &to L_MAC>;)
ZMK_MACRO(rgb_to_l3, wait-ms = <0>; tap-ms = <0>; bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(93,82,100)>,  <&macro_tap &to 3>;)
ZMK_MACRO(rgb_to_l4, wait-ms = <0>; tap-ms = <0>; bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(183,82,100)>, <&macro_tap &to 4>;)


//ref: https://zmk.dev/docs/behaviors/macros#layer-activation--more
ZMK_MACRO(m_lt_num_voldn, wait-ms = <0>; tap-ms = <0>; bindings = 
      <&macro_press &lt L_NUM K_VOL_DN>
    , <&macro_tap &rgb_ug C_PINK>
    , <&macro_pause_for_release>
    , <&macro_release &lt L_NUM>
    , <&macro_tap &rgb_ug C_NONE>;
)




};


